{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifestash",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifestash",
      "database_id": "707616e0-9e12-4d70-a5d7-4cf41a3098f2",
      "migrations_dir": "migrations",
    },
  ],
  // Per-IP limit on sign-in endpoints (core/rate-limit.ts): 10 attempts a minute.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "triggers": {
    // Daily reminder sweep at 06:00 UTC (07:00/08:00 in Skopje).
    "crons": ["0 6 * * *"],
  },
  "observability": { "enabled": true },
}
