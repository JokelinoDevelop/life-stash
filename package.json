{
  "name": "lifestash",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "release": "tsx scripts/release.ts",
    "typecheck": "tsr generate && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.node.json",
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lifestash --local",
    "db:migrate:remote": "wrangler d1 migrations apply lifestash --remote",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "vapid": "pnpm dlx @pushforge/builder vapid",
    "prepare": "lefthook install",
    "routes": "tsr generate",
    "db:seed": "tsx src/worker/db/seed/seed.ts",
    "storage:up": "docker compose up -d garage",
    "storage:setup": "tsx scripts/garage-setup.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@formkit/auto-animate": "^0.10.2",
    "@hono/zod-validator": "^0.9.1",
    "@number-flow/react": "^0.6.2",
    "@pushforge/builder": "^2.0.5",
    "@react-pdf/renderer": "^4.9.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "i18next": "^27.1.5",
    "i18next-browser-languagedetector": "^8.3.1",
    "lucide-react": "^1.74.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@interfere/landmines": "^0.1.1",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-sonarjs": "^4.2.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-react-doctor": "^0.9.23",
    "oxlint-tsgolint": "^7.0.2007",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "^8.3.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.164.0"
  }
}
